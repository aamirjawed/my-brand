<div class="magezon-builder magezon-builder-preload"><div class="oe0vma2 mgz-element mgz-element-row full_width_row_content_no_paddings"><div class="mgz-element-inner oe0vma2-s"><div class="inner-content "><div class="ppir58d mgz-element mgz-element-column mgz-col-xs-12"><div class="mgz-element-inner ppir58d-s"><div class="yw9uqd2 mgz-element mgz-child mgz-element-raw_html banner_info"><div class="mgz-element-inner yw9uqd2-s"><div class="magezon-builder magezon-builder-preload"><div class="nxr9b8c mgz-element mgz-element-row banner full_width_row_content_no_paddings"><div class="mgz-element-inner nxr9b8c-s"><div class="inner-content "><div class="qeldnfn mgz-element mgz-element-column mgz-col-xs-12"><div class="mgz-element-inner qeldnfn-s"><div class="nckpe0i mgz-element mgz-element-section banner_img"><div class="mgz-element-inner nckpe0i-s"><div class="hq969a5 mgz-element mgz-child mgz-element-single_image mgz-hidden-sm mgz-hidden-xs mgz-image-hovers"><div class="mgz-element-inner hq969a5-s"><div class="mgz-single-image-wrapper"><div class="mgz-single-image-inner "><img class="mgz-hover-main" src="/mediaimage/wysiwyg/hero-banner.webp" alt="hero-banner" title="" /></div></div></div></div><div class="ohcm1t6 mgz-element mgz-child mgz-element-video mgz-hidden-xl mgz-hidden-lg mgz-hidden-md mgz-element-title-align-center"><div class="mgz-element-inner ohcm1t6-s"><div class="mgz-block"><div class="mgz-block-content"><div class="mgz-video mgz-video-aspect-ratio-169"><video autoplayMode='on-scroll' class="cld-video-player" playsinline controls autoplay loop muted ><source src="https://assets.olacabs.com/ola-prod-website/banner-video-mob.mp4" type="video/mp4"> Your browser does not support the video tag. </video></div></div></div></div></div></div></div><div class="qowpqpp mgz-element mgz-child mgz-element-raw_html olacabs_search"><div class="mgz-element-inner qowpqpp-s"><div class="container"><div class="picking_info"><h1>Moving people, and the world</h1><div class="picking_tabs_info"><div class="tabs"><button class="tab active" data-tab="Daily" data-target="daily" event-name="desktop_booking_widget_daily" >Daily</button> <button class="tab" data-tab="Rental" data-target="rental" event-name="desktop_booking_widget_rental">Rental</button> <button class="tab" data-tab="Outstation" data-target="outstation" event-name="desktop_booking_widget_outstation">Outstation</button> </div><input type="hidden" id="current_location_placeid" name="current_location_placeid" class="text_placeid"><input type="hidden" id="current_location_lat" name="current_location_lat" class="text_lat"><input type="hidden" id="current_location_lng" name="current_location_lng" class="text_lat"><input type="hidden" id="current_location_address" name="current_location_address" class="text_address"><input type="hidden" id="destination_location_placeid" name="destination_location_placeid" class="text_placeid"><input type="hidden" id="destination_location_lat" name="destination_location_lat" class="text_lat"><input type="hidden" id="destination_location_lng" name="destination_location_lng" class="text_lat"><input type="hidden" id="destination_location_address" name="destination_location_address" class="text_address"><input type="hidden" id="rental_location_package_select" name="rental_location_package_select" class="text_package"><input type="hidden" placeholder="Current Location" name="geolatitude_select" id="geolatitude_select" class="geolatitude_select" value="23.0488561" /><input type="hidden" placeholder="Current Location" name="geolongitude_select" id="geolongitude_select" class="geolongitude_select" value="72.5250177" /><div id="panels"><div id="loader" style="display:none"><img src="https://assets.olacabs.com/ola-prod-website/dot-loader.gif" alt=""></div><div class="daily panel active"><div class="current_location location"><span class="green_dot"></span> <input type="text" placeholder="Current Location" name="textbox1" id="textbox1" class="textbox1" /><div id="select-curr-loc" class="current-location-icon"><img src="https://assets.olacabs.com/ola-prod-website/current-location.svg" alt="Location Icon" /></div><div class="search_location_list location_list"><ul id ="search_location_list" class="search_location_list_data" ></ul></div></div><div class="single_line"></div><div class="enter_destination location"><span class="red_dot"></span> <input type="text" placeholder="Enter Location" name="destination_location" id="destination_location" class="destination_location"/><div class="destination_location_list location_list"><ul id ="destination_location_list" class="destination_location_list_data" ></ul></div></div><button class="search_btn" event-name="desktop_booking_widget_daily_search"><span class="search_txt_white">SEARCH</span> <span class="search_txt_green">OLA CABS</span> <img src="https://assets.olacabs.com/ola-prod-website/forward-arrow.svg" /></button> </div><div class="rental panel"><div class="current_location location"><span class="green_dot"></span> <input type="text" placeholder="Current Location" name="textbox1" id="textbox4" class="textbox1" /><div id="select-curr-loc" class="current-location-icon"><img src="https://assets.olacabs.com/ola-prod-website/current-location.svg" alt="Location Icon" /></div><div class="search_location_list location_list"><ul id="search_location_list" class="search_location_list_data"></ul></div></div><div class="single_line"></div><div class="enter_destination location"><img src="https://assets.olacabs.com/ola-prod-website/clock.svg" /><button class="select_package">Select Package</button> <div class="rental_location_list location_list package_list"><ul id ="rental_location_list" class="rental_location_list_data" ></ul></div></div><button class="search_btn" event-name="desktop_booking_widget_rental_search"><span class="search_txt_white">SEARCH</span> <span class="search_txt_green">RENTAL CABS</span> <img src="https://assets.olacabs.com/ola-prod-website/forward-arrow.svg" /></button> </div><div class="outstation panel"><div class="current_location location"><span class="green_dot"></span> <input type="text" placeholder="Current Location" name="textbox1" id="textbox3" class="textbox1" /><div id="select-curr-loc" class="current-location-icon"><img src="https://assets.olacabs.com/ola-prod-website/current-location.svg" alt="Location Icon" /></div><div class="search_location_list location_list"><ul id ="search_location_list" class="search_location_list_data"></ul></div></div><div class="single_line"></div><div class="enter_destination location"><span class="red_dot"></span> <input type="text" placeholder="Enter Location" name="destination_location" id="destination_location1" class="destination_location" /><div class="destination_location_list location_list"><ul id ="destination_location_list" class="destination_location_list_data"></ul></div></div><button class="search_btn" event-name="desktop_booking_widget_outstation_search"><span class="search_txt_white">SEARCH</span> <span class="search_txt_green">OUTSTATION CABS</span> <img src="https://assets.olacabs.com/ola-prod-website/forward-arrow.svg" /></button> </div></div></div><div class="error_message" style="display:none"> No packages found for currently selected location </div></div></div><script>
    require(['jquery', 'jquery/ui'], function($){
        jQuery(document).ready(function($){
            /* For Search Location Tab Script Start */
            const tabs = document.querySelectorAll(".picking_tabs_info .tabs");
            const tab = document.querySelectorAll(".picking_tabs_info .tab");
            const panel = document.querySelectorAll(".picking_tabs_info .panel");

            function onTabClick(event) {
                for (let i = 0; i < tab.length; i++) {
                    tab[i].classList.remove("active");
                }

                for (let i = 0; i < panel.length; i++) {
                    panel[i].classList.remove("active");
                }
                event.target.classList.add('active');
                let classString = event.target.getAttribute('data-target');
                console.log(classString);
                document.getElementById('panels').getElementsByClassName(classString)[0].classList.add("active");
            }
            for (let i = 0; i < tab.length; i++) {
                tab[i].addEventListener('click', onTabClick, false);
            }

            $(".rental_location_list.location_list.package_list").hide();
            $(document).on('click','.rental .select_package', function(){
                var rental_location_list_data = $('.rental_location_list_data li').length;
                if ($('.rental_location_list_data li').length) {
                    $(".rental_location_list.location_list.package_list").show();
                }else{
                    $(".error_message").show();
                    setTimeout(function() { $(".error_message").hide();}, 3000);
                }
            });

            $(document).on('click','#select-curr-loc', function(){
                $("#loader").show();
                var geolatitude_select = $('#geolatitude_select').val();
                var geolongitude_select = $('#geolongitude_select').val();
                $.ajax({
                type: "GET",
                data: {
                    geolatitude_select: geolatitude_select,
                    geolongitude_select: geolongitude_select
                },
                dataType: 'json',
                url: '/olacabs/api/geolocation/',
                success: function(data) {
                    placedata = data;
                    var placedatashow = placedata.data;
                    $.each(placedatashow , function(index, item) {
                        $('#search_location_list').html('');
                        $('#current_location_lng').html('');
                        $('input[name="current_location_lat"]').val(geolatitude_select);
                        $('input[name="current_location_lng"]').val(geolongitude_select);
                        $('input[name="current_location_address"]').val(item.formattedAddress);     
                        $('input[name="textbox1"]').val(item.formattedAddress);
                        $(".search_location_list.location_list").hide();
                        $("#loader").hide();
                        rentallist_func();
                    });            
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    console.log(xhr.responseText);
                }
                });
            });

            function rentallist_func(){
                var pickupLat = $('#current_location_lat').val();
                var pickupLng = $('#current_location_lng').val();
                var serviceType ='rental';
                $.ajax({
                    type: "GET",
                    data: {
                            pickupLat: pickupLat,
                            pickupLng: pickupLng,
                            serviceType: serviceType
                        },
                    dataType: 'json',
                    url: '/olacabs/api/rental/',
                    success: function(data) {
                        placedata = data;
                        var placedatashow = placedata.data;
                        $('.rental_location_list_data').html('');
                        $.each(placedatashow , function(index, item) { 
                            $.each(item , function(index, items) {
                                $('.rental_location_list_data').append("<li class='item' id ='"+items.id+"'>"+items.description+"</li>");
                            });
                        });                            
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        console.log(xhr.responseText);
                    }
                });
            }

            $(document).on('click','.daily .search_btn', function(){
                var searchdailylink = 'https://book.olacabs.com/?serviceType=p2p&utm_source=widget_on_olacabs';
                var current_location_lat = $('#current_location_lat').val();
                var current_location_lng = $('#current_location_lng').val();
                var current_location_address = $('#current_location_address').val();
                var destination_location_lat =$('#destination_location_lat').val(); 
                var destination_location_lng = $('#destination_location_lng').val();
                var destination_location_address = $('#destination_location_address').val();
                if((!current_location_lat =='')&&(!current_location_lng =='')&&(!current_location_address =='')&&(!destination_location_lat =='')&&(!destination_location_lng =='')&&(!destination_location_address =='')){
                    window.open(searchdailylink+'&drop_lat='+destination_location_lat+'&drop_lng='+destination_location_lng+'&drop_name='+destination_location_address+'&lat='+current_location_lat+'&lng='+current_location_lng+'&pickup_name='+current_location_address+'', '_blank');  
                }else if(current_location_address ==''){
                    $(".error_message").html('Please select a location.');
                    $(".error_message").show();
                    setTimeout(function() { $(".error_message").hide();}, 3000);
                }else{
                    $(".error_message").html('Please select a destination location.');
                    $(".error_message").show();
                    setTimeout(function() { $(".error_message").hide();}, 3000);
                }
            });

            $(document).on('click','.rental .search_btn', function(){
                var searchrentallink = 'https://book.olacabs.com/rental-cabs?serviceType=rentals&utm_source=widget_on_olacabs';
                var rental_location_package_select = $('#rental_location_package_select').val();
                var current_location_lat = $('#current_location_lat').val();
                var current_location_lng = $('#current_location_lng').val();
                var current_location_address = $('#current_location_address').val();
                if((!current_location_lat =='')&&(!current_location_lng =='')&&(!current_location_address =='')&&(!rental_location_package_select =='')){ 
                    window.open(searchrentallink+'&selectedPackage='+rental_location_package_select+'&lat='+current_location_lat+'&lng='+current_location_lng+'&pickup_name='+current_location_address+'', '_blank');  
                }else if(current_location_address ==''){
                    $(".error_message").html('Please select a location.');
                    $(".error_message").show();
                    setTimeout(function() { $(".error_message").hide();}, 3000);
                }else{
                    $(".error_message").html('Please select a package.');
                    $(".error_message").show();
                }
            });

            $(document).on('click','.outstation .search_btn', function(){
                var searchoutstationlink = 'https://book.olacabs.com/outstation-cabs?serviceType=outstation&utm_source=widget_on_olacabs';
                var current_location_lat = $('#current_location_lat').val();
                var current_location_lng = $('#current_location_lng').val();
                var current_location_address = $('#current_location_address').val();
                var destination_location_lat =$('#destination_location_lat').val(); 
                var destination_location_lng = $('#destination_location_lng').val();
                var destination_location_address = $('#destination_location_address').val();
                if((!current_location_lat =='')&&(!current_location_lng =='')&&(!current_location_address =='')&&(!destination_location_lat =='')&&(!destination_location_lng =='')&&(!destination_location_address =='')){
                    window.open(searchoutstationlink+'&drop_lat='+destination_location_lat+'&drop_lng='+destination_location_lng+'&drop_name='+destination_location_address+'&lat='+current_location_lat+'&lng='+current_location_lng+'&pickup_name='+current_location_address+'', '_blank');  
                
                }else if(current_location_address ==''){
                    $(".error_message").html('Please select a location.');
                    $(".error_message").show();
                    setTimeout(function() { $(".error_message").hide();}, 3000);
                }else{
                    $(".error_message").html('Please select a destination location.');
                    $(".error_message").show();
                    setTimeout(function() { $(".error_message").hide();}, 3000);
                }
            });

            

            $(".textbox1").on('input',function() {
                $('.select_package').html('Select Package');
                var GlobalPricingInfo = '';
                var searchTextall = $(this).val();
                $.ajax({
                    type: "GET",
                    data: "query=" + searchTextall,
                    dataType: 'json',
                    url: '/olacabs/api/autocomplete/',
                    success: function(data) {
                        GlobalPricingInfo = data;
                        var datashow = GlobalPricingInfo.data;
                        $('#search_location_list').html('');
                        $('.search_location_list_data').html('');
                        $.each(datashow , function(index, item) { 
                            $('input[name="current_location_placeid"]').val(item.placeId);
                            $('.search_location_list_data').append("<li class='item' id ='"+item.placeId+"'>"+item.name+","+item.address+"</li>");
                            $(".search_location_list.location_list").show();
                            });          
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        console.log(xhr.responseText);
                    }
                });
            });

            
            $(document).on('click','.search_location_list_data li', function(){
                $("#loader").show();
                var placeId = this.id;
                var placeaddress = this.innerHTML;
                $('input[name="textbox1"]').val(placeaddress);
                $(".search_location_list.location_list").hide();
                $.ajax({
                type: "GET",
                data: "placeId=" + placeId,
                dataType: 'json',
                url: '/olacabs/api/place/',
                success: function(data) {
                    placedata = data;
                    var placedatashow = placedata.data;
                    $.each(placedatashow , function(index, item) { 
                        $('#current_location_lng').html('');
                        $("#loader").hide();
                        $('input[name="current_location_lat"]').val(item.lat);
                        $('input[name="current_location_lng"]').val(item.lng);
                        $('input[name="current_location_address"]').val(item.formattedAddress);
                    });            
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    console.log(xhr.responseText);
                }
                });
            });

            
            $(document).on('click','.rental .search_location_list_data li', function(){
                $('.rental_location_list_data').html('');
                setTimeout(function() {
                    rentallist_func();
                }, 1000);
            });

            
            $(document).on('click','.rental_location_list_data li', function(){
                var placeId = this.id;
                var placeaddress = this.innerHTML;
                $(".rental_location_list.location_list.package_list").hide();
                $('input[name="rental_location_package_select"]').val(placeId);
                $('.select_package').html(placeaddress);
            });

            
            $(".destination_location").on('input',function() {
                var searchText = $(this).val();
                var GlobalPricingInfo = '';
                $.ajax({
                type: "GET",
                data: "query=" + searchText,
                dataType: 'json',
                url: '/olacabs/api/autocomplete/',
                success: function(data) {
                    GlobalPricingInfo = data;
                    var datashow = GlobalPricingInfo.data;
                    $('#destination_location_list').html('');
                    $('.destination_location_list_data').html('');
                    $.each(datashow , function(index, item) {
                        $('input[name="current_location_placeid"]').val(item.placeId);
                        $('#destination_location_list').append("<li class='item' id ='"+item.placeId+"'>"+item.name+","+item.address+"</li>");
                        $('.destination_location_list_data').append("<li class='item' id ='"+item.placeId+"'>"+item.name+","+item.address+"</li>"); 
                        $(".destination_location_list.location_list").show();
                        });
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    console.log(xhr.responseText);
                }
                });
            });

            
            $(document).on('click','.destination_location_list li', function(){
                var placeId = this.id;
                var placeaddress = this.innerHTML;
                $('input[name="destination_location"]').val(placeaddress);
                $(".destination_location_list.location_list").hide();
                $.ajax({
                type: "GET",
                data: "placeId=" + placeId,
                dataType: 'json',
                url: '/olacabs/api/place/',
                
                success: function(data) {
                    placedata = data;
                    var placedatashow = placedata.data;
                    $.each(placedatashow , function(index, item) {
                        $('input[name="destination_location_lat"]').val(item.lat);
                        $('input[name="destination_location_lng"]').val(item.lng);
                        $('input[name="destination_location_address"]').val(item.formattedAddress);
                        });            
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    console.log(xhr.responseText);
                }
                });
            });

        });
    });

<p>We constantly experiment to come up with industry-first features for our riders that eventually become a norm.</p></div></div></div></div><div class="qdnkwa5 mgz-element mgz-element-column making_innovations_left mgz-col-md-6"><div class="mgz-element-inner qdnkwa5-s"><div class="aesrrcb mgz-element mgz-child mgz-element-video mgz-element-title-align-center"><div class="mgz-element-inner aesrrcb-s"><div class="mgz-block"><div class="mgz-block-content"><div class="mgz-video mgz-video-aspect-ratio-169"><video autoplayMode='on-scroll' class="cld-video-player" playsinline autoplay muted ><source src="https://assets.olacabs.com/ola-prod-website/for-drivers.mp4" type="video/mp4"> Your browser does not support the video tag. </video></div></div></div></div></div><div class="f91ut3g mgz-element mgz-child mgz-element-text making_innovations_title"><div class="mgz-element-inner f91ut3g-s"><p>For Drivers</p></div></div><div class="v8ca13h mgz-element mgz-child mgz-element-text making_innovations_desc"><div class="mgz-element-inner v8ca13h-s"><p>Our drivers get real time stats to help optimize their rides better and earn more, straight from the app.</p></div></div></div></div></div></div></div></div></div></div></div></div><div class="miftqda mgz-element mgz-element-row full_width_row"><div class="mgz-element-inner miftqda-s"><div class="inner-content mgz-container"><div class="ddqlpbn mgz-element mgz-element-column mgz-col-xs-12"><div class="mgz-element-inner ddqlpbn-s"><div class="jrwpcy9 mgz-element mgz-child mgz-element-raw_js"><div class="mgz-element-inner jrwpcy9-s"><script> 
const rider_video = document.querySelector('#riders_video video');
    const drivers_video =  document.querySelector('#drivers_video video');
    const progressBar1 = document.querySelector('#progressBar1 .mgz-element-inner');
    const progressBar2 = document.querySelector('#progressBar2 .mgz-element-inner');

    rider_video.addEventListener('timeupdate', function() {
        const progress = (rider_video.currentTime / rider_video.duration) * 100;
        progressBar1.style.height = progress + '%';
        progressBar2.style.height = '0';
        drivers_video.style.display = 'none';
    });

    rider_video.addEventListener('ended', function() {
        rider_video.style.display = 'none';
        drivers_video.style.display = 'block';
        drivers_video.play();
        progressBar1.style.height = '0';
        progressBar2.style.height = '0';
    });

    drivers_video.addEventListener('timeupdate', function() {
        const progress = (drivers_video.currentTime / drivers_video.duration) * 100;
        progressBar2.style.height = progress + '%';
        progressBar1.style.height = '0';
    });

    drivers_video.addEventListener('ended', function() {
        drivers_video.style.display = 'none';
        rider_video.style.display = 'block';
        rider_video.play();
        progressBar1.style.height = '0';
        progressBar2.style.height = '0';
